<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Kodi 19+ settings schema: "default" is a CHILD ELEMENT, not an attribute.
     Using default="..." makes Kodi fail to read every setting in the file and
     getSettingInt/Bool then raise "Invalid setting type" at runtime.
     A string setting with an empty default also needs
     <constraints><allowempty>true</allowempty></constraints>, otherwise Kodi
     logs "error reading the default value" and drops the setting. -->
<settings version="1">
  <section id="plugin.video.uhd">
    <category id="account" label="30100">
      <group id="1" label="30101">
        <setting id="server" type="string" label="30110" help="30111">
          <level>0</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30110</heading>
          </control>
        </setting>
        <setting id="username" type="string" label="30112">
          <level>0</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30112</heading>
          </control>
        </setting>
        <setting id="password" type="string" label="30113">
          <level>0</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30113</heading>
            <hidden>true</hidden>
          </control>
        </setting>
        <setting id="device_id" type="string" label="30114">
          <level>4</level>
          <default/>
          <constraints>
            <allowempty>true</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30114</heading>
          </control>
        </setting>
      </group>
    </category>
    <category id="browsing" label="30200">
      <group id="1" label="30201">
        <setting id="page_size" type="integer" label="30210" help="30211">
          <level>0</level>
          <default>50</default>
          <constraints>
            <minimum>10</minimum>
            <step>10</step>
            <maximum>200</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="sort_by" type="integer" label="30212">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="30220">0</option>
              <option label="30221">1</option>
              <option label="30222">2</option>
              <option label="30223">3</option>
              <option label="30224">4</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="sort_desc" type="boolean" label="30213">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
        <setting id="ask_version" type="boolean" label="30218" help="30219">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="view_mode" type="integer" label="30214" help="30215">
          <level>0</level>
          <default>54</default>
          <constraints>
            <options>
              <option label="30232">54</option>
              <option label="30231">51</option>
              <option label="30236">50</option>
              <option label="30230">0</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="root_view_mode" type="integer" label="30216" help="30217">
          <level>0</level>
          <default>54</default>
          <constraints>
            <options>
              <option label="30232">54</option>
              <option label="30234">500</option>
              <option label="30235">55</option>
              <option label="30230">0</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
      </group>
    </category>
    <category id="advanced" label="30250">
      <group id="1" label="30251">
        <setting id="timeout" type="integer" label="30260">
          <level>1</level>
          <default>20</default>
          <constraints>
            <minimum>5</minimum>
            <step>5</step>
            <maximum>120</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="verify_ssl" type="boolean" label="30261" help="30262">
          <level>2</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
